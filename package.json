{
  "name": "aalto-fitech-code",
  "displayName": "Aalto Fitech Platform",
  "description": "WIP",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aaltoFitechPlatform.checkPlatformStatus",
    "onView:aaltoFitechPlatform.account",
    "onView:aaltoFitechPlatform.courses"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aaltoFitechPlatform",
          "title": "Aalto Fitech Platform",
          "icon": "media/wsd-platform.svg"
        }
      ]
    },
    "views": {
      "aaltoFitechPlatform": [
        {
          "id": "aaltoFitechPlatform.account",
          "name": "Account"
        },
        {
          "id": "aaltoFitechPlatform.courses",
          "name": "Courses"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aaltoFitechPlatform.account",
        "contents": "Sign in to access your Aalto Fitech Platform account.\n\n[Sign In](command:aaltoFitechPlatform.signIn)"
      }
    ],
    "commands": [
      {
        "command": "aaltoFitechPlatform.checkPlatformStatus",
        "title": "Aalto Fitech Platform: Check Platform Status"
      },
      {
        "command": "aaltoFitechPlatform.signIn",
        "title": "Aalto Fitech Platform: Sign In"
      },
      {
        "command": "aaltoFitechPlatform.showCurrentUser",
        "title": "Aalto Fitech Platform: Show Current User"
      },
      {
        "command": "aaltoFitechPlatform.signOut",
        "title": "Aalto Fitech Platform: Sign Out"
      },
      {
        "command": "aaltoFitechPlatform.refreshCourses",
        "title": "Aalto Fitech Platform: Refresh Courses",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aaltoFitechPlatform.refreshCourses",
          "when": "view == aaltoFitechPlatform.courses",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Aalto Fitech Platform",
      "properties": {
        "aaltoFitechPlatform.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8842/api",
          "description": "Base URL of the Fitech platform API."
        },
        "aaltoFitechPlatform.useMockApi": {
          "type": "boolean",
          "default": true,
          "description": "Use mock platform data instead of the real API."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "jszip": "^3.10.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
