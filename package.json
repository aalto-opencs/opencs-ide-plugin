{
  "name": "aalto-opencs-ide",
  "displayName": "Aalto OpenCS IDE",
  "description": "Browse Aalto OpenCS courses, download programming assignments, and view grader feedback in compatible IDEs.",
  "version": "0.0.1",
  "publisher": "aalto-opencs",
  "author": {
    "name": "Aalto OpenCS IDE extension contributors"
  },
  "license": "UNLICENSED",
  "preview": true,
  "pricing": "Free",
  "icon": "media/aalto-opencs-ide-marketplace.png",
  "galleryBanner": {
    "color": "#202124",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "Aalto",
    "OpenCS",
    "education",
    "courses",
    "assignments",
    "learning platform",
    "grader"
  ],
  "activationEvents": [
    "onUri",
    "onCommand:aaltoOpenCsIde.checkPlatformStatus",
    "onCommand:aaltoOpenCsIde.selectCourse",
    "onCommand:aaltoOpenCsIde.selectAssignmentFolder",
    "onCommand:aaltoOpenCsIde.downloadAssignment",
    "onCommand:aaltoOpenCsIde.showAssignmentFolder",
    "onCommand:aaltoOpenCsIde.redownloadAssignment",
    "onCommand:aaltoOpenCsIde.submitAssignment",
    "onView:aaltoOpenCsIde.authenticationSetup",
    "onView:aaltoOpenCsIde.folderSetup",
    "onView:aaltoOpenCsIde.courseSelection",
    "onView:aaltoOpenCsIde.courseParts",
    "onView:aaltoOpenCsIde.exercise",
    "onView:aaltoOpenCsIde.submissions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aaltoOpenCsIde",
          "title": "Aalto OpenCS IDE",
          "icon": "media/aalto-opencs-ide.svg"
        }
      ]
    },
    "views": {
      "aaltoOpenCsIde": [
        {
          "id": "aaltoOpenCsIde.authenticationSetup",
          "name": "Authentication",
          "when": "!aaltoOpenCsIde.signedIn"
        },
        {
          "id": "aaltoOpenCsIde.folderSetup",
          "name": "Assignment Folder",
          "when": "aaltoOpenCsIde.signedIn && !aaltoOpenCsIde.assignmentFolderSelected"
        },
        {
          "id": "aaltoOpenCsIde.courseSelection",
          "name": "Course Selection",
          "when": "aaltoOpenCsIde.setupComplete"
        },
        {
          "id": "aaltoOpenCsIde.courseParts",
          "name": "Course Parts",
          "when": "aaltoOpenCsIde.setupComplete"
        },
        {
          "id": "aaltoOpenCsIde.exercise",
          "name": "Exercise",
          "when": "aaltoOpenCsIde.setupComplete"
        },
        {
          "id": "aaltoOpenCsIde.submissions",
          "name": "Submissions",
          "when": "aaltoOpenCsIde.setupComplete"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aaltoOpenCsIde.authenticationSetup",
        "contents": "Sign in through the Aalto OpenCS platform in your web browser.\n\n[Sign In with Browser](command:aaltoOpenCsIde.signIn)",
        "when": "!aaltoOpenCsIde.signedIn"
      },
      {
        "view": "aaltoOpenCsIde.folderSetup",
        "contents": "Choose where programming assignments will be downloaded.\n\n[Choose Assignment Folder](command:aaltoOpenCsIde.selectAssignmentFolder)",
        "when": "aaltoOpenCsIde.signedIn && !aaltoOpenCsIde.assignmentFolderSelected"
      },
      {
        "view": "aaltoOpenCsIde.courseSelection",
        "contents": "Select the course and version you want to work on.\n\n[Select Course](command:aaltoOpenCsIde.selectCourse)",
        "when": "aaltoOpenCsIde.signedIn && aaltoOpenCsIde.assignmentFolderSelected && !aaltoOpenCsIde.courseSelected"
      },
      {
        "view": "aaltoOpenCsIde.courseParts",
        "contents": "Select a course and version to show its course parts.\n\n[Select Course](command:aaltoOpenCsIde.selectCourse)",
        "when": "aaltoOpenCsIde.setupComplete && !aaltoOpenCsIde.courseSelected"
      },
      {
        "view": "aaltoOpenCsIde.exercise",
        "contents": "Choose a coding assignment from Course Parts.",
        "when": "aaltoOpenCsIde.setupComplete && !aaltoOpenCsIde.currentAssignmentSelected"
      },
      {
        "view": "aaltoOpenCsIde.exercise",
        "contents": "Download the current exercise to browse and edit its files.\n\n[Download Exercise](command:aaltoOpenCsIde.downloadCurrentAssignment)",
        "when": "aaltoOpenCsIde.currentAssignmentSelected && !aaltoOpenCsIde.currentAssignmentDownloaded"
      },
      {
        "view": "aaltoOpenCsIde.submissions",
        "contents": "Choose a coding assignment from Course Parts to see its submissions.",
        "when": "aaltoOpenCsIde.setupComplete && !aaltoOpenCsIde.currentAssignmentSelected"
      }
    ],
    "commands": [
      {
        "command": "aaltoOpenCsIde.showAccount",
        "title": "Aalto OpenCS IDE: Account",
        "shortTitle": "Account",
        "icon": "$(account)"
      },
      {
        "command": "aaltoOpenCsIde.checkPlatformStatus",
        "title": "Aalto OpenCS IDE: Check Platform Status"
      },
      {
        "command": "aaltoOpenCsIde.signIn",
        "title": "Aalto OpenCS IDE: Sign In"
      },
      {
        "command": "aaltoOpenCsIde.showCurrentUser",
        "title": "Aalto OpenCS IDE: Show Current User"
      },
      {
        "command": "aaltoOpenCsIde.signOut",
        "title": "Aalto OpenCS IDE: Sign Out",
        "shortTitle": "Sign Out"
      },
      {
        "command": "aaltoOpenCsIde.refreshCourses",
        "title": "Aalto OpenCS IDE: Refresh Courses",
        "shortTitle": "Refresh Courses",
        "icon": "$(refresh)"
      },
      {
        "command": "aaltoOpenCsIde.selectCourse",
        "title": "Aalto OpenCS IDE: Select Course and Version",
        "shortTitle": "Change Course",
        "icon": "$(list-selection)"
      },
      {
        "command": "aaltoOpenCsIde.selectAssignmentFolder",
        "title": "Aalto OpenCS IDE: Select Assignment Folder",
        "shortTitle": "Change Assignment Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aaltoOpenCsIde.downloadAssignment",
        "title": "Aalto OpenCS IDE: Download Assignment",
        "shortTitle": "Download Assignment",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aaltoOpenCsIde.submitAssignment",
        "title": "Aalto OpenCS IDE: Submit Assignment",
        "shortTitle": "Submit Assignment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aaltoOpenCsIde.submitCurrentAssignment",
        "title": "Aalto OpenCS IDE: Submit Current Exercise",
        "shortTitle": "Submit Current Exercise",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aaltoOpenCsIde.showAssignmentFolder",
        "title": "Aalto OpenCS IDE: Show Local Assignment Folder",
        "shortTitle": "Show Local Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aaltoOpenCsIde.redownloadAssignment",
        "title": "Aalto OpenCS IDE: Redownload Assignment",
        "shortTitle": "Redownload Assignment",
        "icon": "$(sync)"
      },
      {
        "command": "aaltoOpenCsIde.refreshSubmissions",
        "title": "Aalto OpenCS IDE: Refresh Submissions",
        "icon": "$(refresh)"
      },
      {
        "command": "aaltoOpenCsIde.refreshExercise",
        "title": "Aalto OpenCS IDE: Refresh Exercise Files",
        "icon": "$(refresh)"
      },
      {
        "command": "aaltoOpenCsIde.selectAssignment",
        "title": "Aalto OpenCS IDE: Select Exercise"
      },
      {
        "command": "aaltoOpenCsIde.downloadCurrentAssignment",
        "title": "Aalto OpenCS IDE: Download Current Exercise"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aaltoOpenCsIde.showAccount",
          "when": "aaltoOpenCsIde.setupComplete && view == aaltoOpenCsIde.courseSelection",
          "group": "navigation"
        },
        {
          "command": "aaltoOpenCsIde.selectCourse",
          "when": "view == aaltoOpenCsIde.courseSelection",
          "group": "navigation@1"
        },
        {
          "command": "aaltoOpenCsIde.refreshCourses",
          "when": "view == aaltoOpenCsIde.courseParts && aaltoOpenCsIde.courseSelected",
          "group": "navigation@1"
        },
        {
          "command": "aaltoOpenCsIde.refreshExercise",
          "when": "view == aaltoOpenCsIde.exercise && aaltoOpenCsIde.currentAssignmentDownloaded",
          "group": "navigation@1"
        },
        {
          "command": "aaltoOpenCsIde.refreshSubmissions",
          "when": "view == aaltoOpenCsIde.submissions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aaltoOpenCsIde.downloadAssignment",
          "when": "view == aaltoOpenCsIde.courseParts && (viewItem == programmingExercise || viewItem == completedProgrammingExercise)",
          "group": "inline@1"
        },
        {
          "command": "aaltoOpenCsIde.downloadAssignment",
          "when": "view == aaltoOpenCsIde.courseParts && (viewItem == programmingExercise || viewItem == completedProgrammingExercise)",
          "group": "navigation"
        },
        {
          "command": "aaltoOpenCsIde.submitAssignment",
          "when": "view == aaltoOpenCsIde.courseParts && viewItem == downloadedProgrammingExercise",
          "group": "inline@1"
        },
        {
          "command": "aaltoOpenCsIde.submitAssignment",
          "when": "view == aaltoOpenCsIde.courseParts && (viewItem == downloadedProgrammingExercise || viewItem == completedDownloadedProgrammingExercise)",
          "group": "navigation"
        },
        {
          "command": "aaltoOpenCsIde.showAssignmentFolder",
          "when": "view == aaltoOpenCsIde.courseParts && viewItem == completedDownloadedProgrammingExercise",
          "group": "inline@1"
        },
        {
          "command": "aaltoOpenCsIde.showAssignmentFolder",
          "when": "view == aaltoOpenCsIde.courseParts && (viewItem == downloadedProgrammingExercise || viewItem == completedDownloadedProgrammingExercise)",
          "group": "navigation@1"
        },
        {
          "command": "aaltoOpenCsIde.redownloadAssignment",
          "when": "view == aaltoOpenCsIde.courseParts && (viewItem == downloadedProgrammingExercise || viewItem == completedDownloadedProgrammingExercise)",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aaltoOpenCsIde.downloadAssignment",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.submitAssignment",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.submitCurrentAssignment",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.showAssignmentFolder",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.redownloadAssignment",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.selectAssignment",
          "when": "false"
        },
        {
          "command": "aaltoOpenCsIde.downloadCurrentAssignment",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Aalto OpenCS IDE",
      "properties": {
        "aaltoOpenCsIde.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8842/api",
          "scope": "machine",
          "description": "Base URL of the Aalto OpenCS platform API. Use the local URL only for development."
        },
        "aaltoOpenCsIde.platformBaseUrl": {
          "type": "string",
          "default": "http://localhost:7799",
          "scope": "machine",
          "description": "Website URL used for browser sign-in. Set this to the production Aalto OpenCS platform URL outside local development."
        },
        "aaltoOpenCsIde.useMockApi": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Use built-in demonstration data instead of contacting the configured platform API. Intended for extension development only."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:integration": "./scripts/run-integration-tests.sh",
    "test:backend-auth": "./scripts/run-integration-tests.sh",
    "mock-api:enable": "./scripts/set-mock-api.sh enable",
    "mock-api:disable": "./scripts/set-mock-api.sh disable"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "jszip": "^3.10.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
